# Hostinger (Apache).
Options -MultiViews
RewriteEngine On

# ---------------------------------------------------------------- attack filter (25 Nov 2026)
# The site is static pages plus two small PHP scripts, so anything that looks like an attack,
# a vulnerability scan or a probe for other software is refused (403) before it reaches anything.
<IfModule mod_rewrite.c>
  # 1. Only normal browsing and our forms: GET, HEAD, POST (and OPTIONS for the form check).
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$
  RewriteRule ^ - [F,L]

  # 2. Known attack and scanner tools.
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|zgrab|acunetix|wpscan|netsparker|nessus|openvas|dirbuster|gobuster|ffuf|feroxbuster|nuclei|havij|w3af|jorgee|morfeus|zmeu|libwww-perl) [NC]
  RewriteRule ^ - [F,L]

  # 3. Attack patterns in the address: database injection, script injection, reading server
  #    files, loading remote code. Real visitors never send these.
  RewriteCond %{QUERY_STRING} (union(\s|\+|%20|/\*)+(all(\s|\+|%20)+)?select|information_schema|(%27|')(\s|\+|%20)*(or|and)(\s|\+|%20)+[0-9'%]|sleep\(|benchmark\(|waitfor(\s|\+|%20)+delay|;(\s|\+|%20)*drop(\s|\+|%20)+table) [NC,OR]
  RewriteCond %{QUERY_STRING} (<|%3C).{0,10}(script|iframe|svg|img|object|embed)|javascript:|vbscript:|onerror\s*=|onload\s*= [NC,OR]
  RewriteCond %{QUERY_STRING} (\.\./|\.\.%2f|%2e%2e|etc/passwd|proc/self|boot\.ini|win\.ini) [NC,OR]
  RewriteCond %{QUERY_STRING} (php://|file://|expect://|phar://|base64_(en|de)code|eval\(|shell_exec|passthru\(|\$\{jndi|%24%7Bjndi) [NC,OR]
  RewriteCond %{QUERY_STRING} (%00|%0d%0a) [NC]
  RewriteRule ^ - [F,L]
  RewriteCond %{THE_REQUEST} (\.\./|%2e%2e|%00|<script|\$\{jndi|%24%7Bjndi) [NC]
  RewriteRule ^ - [F,L]

  # 4. Probes for software we do not run (WordPress, admin panels, config and backup files).
  RewriteRule (^|/)(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|wp-config\.php|phpmyadmin|pma|adminer(\.php)?|cgi-bin|vendor/phpunit|server-status|\.env|\.aws|\.ssh|\.svn|\.hg|config\.(php|json|ya?ml)|composer\.(json|lock)|package(-lock)?\.json|web\.config|id_rsa)(/|$) - [F,NC,L]
  RewriteRule \.(zip|tar|gz|tgz|rar|7z|bak|old|orig|save|swp|sql|db|sqlite|env|ini|conf|cfg|yml|yaml|toml|log|sh|py|md|phar|phtml|php[0-9])$ - [F,NC,L]

  # 5. PHP runs only for our two scripts. Any other .php file (for example one slipped in
  #    by an attacker) is refused instead of executed.
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{REQUEST_URI} !^/api/(send|ai-search)\.php$ [NC]
  RewriteRule ^ - [F,L]

  # 6. The two scripts accept posts only from a browser (scripts without a browser name are refused).
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteCond %{HTTP_USER_AGENT} ^-?$
  RewriteRule ^ - [F,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Resource-Policy "same-site"
</IfModule>

# Forms post to /api/send; on Hostinger that is the PHP version.
RewriteRule ^api/send/?$ api/send.php [L]
RewriteRule ^api/ai-search/?$ api/ai-search.php [L]

# Clean URLs: /buy serves buy.html, and /buy.html redirects to /buy.
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+?)/?$ $1.html [L]

# Speed (24 Nov 2026): compress text files, and let browsers keep images, CSS and JS.
# CSS/JS links carry ?v=N and change name on every edit, so a long cache is safe.
# Pages, data and the service worker are always checked for a newer copy.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|.*\.html|.*\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------- security (25 Nov 2026)
# Never serve the repository, build tools, notes or hidden files (.git, .env ...).
RedirectMatch 404 /\.(?!well-known)
RedirectMatch 404 ^/(tools|brand)/
RedirectMatch 404 \.(py|md|sh|lock|log|ini|bak|sql)$
Options -Indexes

<IfModule mod_headers.c>
  # Browsers: only HTTPS for a year; no MIME guessing; no framing by other sites; share only the
  # site name with other sites; no camera/mic; and a content policy that only runs our own scripts.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), payment=(), usb=(), geolocation=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://analytics.ahrefs.com https://open.er-api.com https://api.github.com https://wsrv.nl; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By
</IfModule>

# The Buy test page became the Buy page (25 Nov 2026).
RedirectMatch 301 ^/buytest(\.html)?$ /buy
