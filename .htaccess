# Hostinger (Apache) only — Vercel ignores this file.
Options -MultiViews
RewriteEngine On

# Forms post to /api/send; on Hostinger that is the PHP version.
RewriteRule ^api/send/?$ api/send.php [L]

# Clean URLs like Vercel: /buy serves buy.html, and /buy.html redirects to /buy.
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+?)/?$ $1.html [L]
