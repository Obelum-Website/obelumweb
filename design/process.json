  "#options div.cta__inner": {
   "_origHtml": "\n    <div class=\"cta__copy\" style=\"padding: 0px !important; translate: 43px !important; max-width: 810px !important;\">\n      <span class=\"eyebrow eyebrow--lg\">Investment advisor · 1 minute</span>\n      <h2 class=\"h2\" id=\"options-h\" style=\"margin-top: 68px !important;\">Choose your <span class=\"italic\">type of Property.</span></h2>\n      <p class=\"poptions__text\" style=\"display: none !important; margin-top: 68px !important;\">Answer 7 quick questions and our system cross-references your answers with all our properties, including the ones that are not on the portals.</p>\n      <ul class=\"poptions__points\" style=\"margin-top: 68px !important;\">\n        <li>Free and no commitment</li>\n        <li>Instant result</li>\n        <li>Includes off-portal opportunities</li>\n      </ul>\n    </div>\n\n    <form class=\"valuation\" method=\"post\" data-options=\"\" novalidate=\"\">\n      <input class=\"hp\" type=\"text\" name=\"_honey\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">\n      <fieldset class=\"pchoices\">\n        <legend class=\"intents__legend\">What are you looking for in Dubai?</legend>\n        <div class=\"pchoices__grid\">\n          <label class=\"pchoice\">\n            <input class=\"pchoice__input\" type=\"radio\" name=\"goal\" value=\"Invest to Rent\">\n            <span class=\"pchoice__box\">\n              <span class=\"pchoice__title\">Invest to Rent</span>\n              <span class=\"pchoice__sub\">Make my money work</span>\n            </span>\n          </label>\n          <label class=\"pchoice\">\n            <input class=\"pchoice__input\" type=\"radio\" name=\"goal\" value=\"Live in\">\n            <span class=\"pchoice__box\">\n              <span class=\"pchoice__title\">Live in.</span>\n              <span class=\"pchoice__sub\">A home for me or my family</span>\n            </span>\n          </label>\n          <label class=\"pchoice\">\n            <input class=\"pchoice__input\" type=\"radio\" name=\"goal\" value=\"Flip it\">\n            <span class=\"pchoice__box\">\n              <span class=\"pchoice__title\">Flip it.</span>\n              <span class=\"pchoice__sub\">Live part of the year and rent it out</span>\n            </span>\n          </label>\n        </div>\n      </fieldset>\n\n      <div class=\"valuation__row\">\n        <div class=\"field\">\n          <label for=\"o-name\">Name</label>\n          <input id=\"o-name\" name=\"name\" type=\"text\" autocomplete=\"name\" placeholder=\"Your name\" maxlength=\"60\" data-rule=\"name\" required=\"\">\n        </div>\n        <div class=\"field field--phone\">\n          <label for=\"o-phone\">Phone</label>\n          <div class=\"phone\">\n            <div class=\"phone__cc\">\n              <span class=\"phone__cc-label\" aria-hidden=\"true\" data-cc-label=\"\">🇦🇪 +971</span>\n              <select class=\"phone__code\" name=\"phone_code\" aria-label=\"Country code\" data-country-code=\"\"><option value=\"AE\">🇦🇪  +971  United Arab Emirates</option><option value=\"IN\">🇮🇳  +91  India</option><option value=\"GB\">🇬🇧  +44  United Kingdom</option><option value=\"RU\">🇷🇺  +7  Russia</option><option value=\"SA\">🇸🇦  +966  Saudi Arabia</option><option value=\"PK\">🇵🇰  +92  Pakistan</option><option value=\"EG\">🇪🇬  +20  Egypt</option><option value=\"PH\">🇵🇭  +63  Philippines</option><option value=\"CN\">🇨🇳  +86  China</option><option value=\"US\">🇺🇸  +1  United States</option><option value=\"\" disabled=\"\">──────────</option><option value=\"AF\">🇦🇫  +93  Afghanistan</option><option value=\"AL\">🇦🇱  +355  Albania</option><option value=\"DZ\">🇩🇿  +213  Algeria</option><option value=\"AS\">🇦🇸  +1684  American Samoa</option><option value=\"AD\">🇦🇩  +376  Andorra</option><option value=\"AO\">🇦🇴  +244  Angola</option><option value=\"AI\">🇦🇮  +1264  Anguilla</option><option value=\"AG\">🇦🇬  +1268  Antigua and Barbuda</option><option value=\"AR\">🇦🇷  +54  Argentina</option><option value=\"A